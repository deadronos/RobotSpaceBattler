{
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "printWidth": 80,
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    "coverage/",
    "playwright-report/",
    "playwright/.cache/",
    "test-results/",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "src/auto-imports.d.ts"
  ]
}
