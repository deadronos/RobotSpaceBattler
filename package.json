{
  "name": "space-station-autobattler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode production",
    "preview": "vite preview",
    "lint": "oxlint src tests playwright --deny-warnings && node ./scripts/check_source_size.js",
    "lint:fix": "oxlint src tests playwright --fix",
    "format": "oxfmt src tests scripts playwright vite.config.ts vitest.config.ts playwright.config.ts",
    "format:check": "oxfmt --check src tests scripts playwright vite.config.ts vitest.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "playwright:install": "playwright install",
    "playwright:test": "playwright test",
    "playwright:preview": "playwright test -c playwright.preview.config.ts smoke pathfinding-worker",
    "playwright:smoke:live": "playwright test -c playwright.preview.config.ts smoke",
    "bench": "node ./scripts/perf/ai-bench.js",
    "perf:vfx-instancing": "node ./scripts/perf/measure_drawcalls.js",
    "check:source-size": "node ./scripts/check_source_size.js",
    "check:bundle": "node ./scripts/check_bundle_budget.js",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "{src,tests,playwright}/**/*.{ts,tsx,js,jsx}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "**/*.{md,json}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "miniplex": "^2.0.0",
    "navmesh": "^2.3.1",
    "postprocessing": "^6.39.5",
    "r3f-perf": "^7.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-draggable": "^4.7.2",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@react-three/test-renderer": "^9.1.1",
    "@responsive-image/vite-plugin": "^3.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.5",
    "gltf-pipeline": "^4.3.1",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^7.0.2",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.3.5",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-glsl": "^1.6.2",
    "vite-plugin-svgr": "^5.2.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@swc/core@1.15.47": true,
    "core-js@3.49.0": true,
    "fsevents@2.3.3": true
  }
}
